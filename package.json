{
  "name": "rl-stream-finder",
  "productName": "RLStreamFinder",
  "version": "0.1.0",
  "description": "Find live streamers in your Rocket League matches.",
  "author": "Ethan McCormack",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24 <25"
  },
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "dev": "electron-forge start",
    "twitch:debug": "pnpm build && electron . --twitch-debug",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "package:linux": "electron-forge package --platform=linux",
    "make:linux": "electron-forge make --platform=linux",
    "make:linux:zip": "electron-forge make --platform=linux --targets=@electron-forge/maker-zip",
    "make:windows": "electron-forge make --platform=win32 --arch=x64 --targets=@electron-forge/maker-squirrel",
    "publish": "electron-forge publish",
    "build": "electron-forge package",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test:smoke": "pnpm run package && playwright test --config playwright.config.ts",
    "test:smoke:build": "pnpm run package && E2E_MODE=build playwright test --config playwright.config.ts",
    "screenshots:demo": "pnpm run package && playwright test --config playwright.demo.config.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@twurple/api": "8.2.0",
    "@twurple/auth": "8.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@playwright/test": "^1.63.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "44.4.5",
    "lodash": "4.18.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
